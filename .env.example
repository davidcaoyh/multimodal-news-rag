# Copy to .env and fill in.  .env is gitignored — never commit the real key.
#
#   cp .env.example .env
#
# Get a key at https://platform.openai.com/api-keys
# Create a RESTRICTED project key with exactly one permission:
#     Model capabilities -> Chat completions (/v1/chat/completions) = Request
# Leave everything else None. Embeddings are NOT needed (SBERT/CLIP run locally).
# Set a $5-10 spend cap on the project while you are in the console.
OPENAI_API_KEY=sk-proj-...

# Day 5 only — the faithfulness judge (D4). Different model family from the
# generator on purpose: gpt-4o-mini grading its own summaries is self-preference
# bias sitting on the headline B1-vs-M number.
#
# Get a key at https://console.anthropic.com/settings/keys
# A Claude Code / claude.ai subscription does NOT grant script API access.
# Set a $5 spend cap — the whole Day 5 judge run is ~$2.80.
ANTHROPIC_API_KEY=sk-ant-...
