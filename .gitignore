# NOTE: git does NOT support trailing inline comments in .gitignore.
# Every comment must be on its own line, or the pattern silently breaks.

# --- Secrets ---------------------------------------------------------------
# .env holds OPENAI_API_KEY and must never be committed.
# .env.example IS committed, as the template.
.env

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtualenvs (1.4 GB — always rebuild locally) --------------------------
.venv/
venv/
env/

# --- OS / editor -----------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp

# --- Data ------------------------------------------------------------------
# The corpus IS committed on purpose: data/processed/*.parquet (5 MB) and
# data/images/ (38 MB). Every teammate must index the IDENTICAL 1023 pairs or
# B1-vs-M numbers aren't comparable across machines. Do NOT add `data/` here.
#
# Only rebuildable artifacts are ignored below.
#
# vestigial; HF caches to ~/.cache/huggingface instead
data/raw/
# Day 2 — regenerate with src/embed.py
data/embeddings/
# Day 2 — regenerate with src/index.py
data/index/
*.faiss
*.npy
# Day 3 — prompt-hash cache; local, may hold API responses
data/llm_cache/

# --- Results ---------------------------------------------------------------
# plots are regenerated by src/evaluate.py; metrics.csv IS tracked
results/*.png
